# Zabbix API (copy this file to .env and fill in real values)
#
# Create an API token in Zabbix UI:
#   Users → API tokens → Create API token
# Required role: Admin / Super admin with SLA update permission

zabbix-address: https://zabbix.example.com
zabbix-token: your-api-token-here

# Timezone used when you type Start time (IANA name). Should match your SLA timezone in Zabbix.
timezone: UTC

# ---------------------------------------------------------------------------
# Services — optional order list (comma-separated).
# To ADD a service: add a sla.<Name> line (and optionally append to services:).
# To REMOVE: comment out / delete its sla.<Name> line (and remove from services:).
# Any sla.* line is loaded even if missing from services:.
# ---------------------------------------------------------------------------
services: AppOne, AppTwo

# Exact Zabbix SLA names for each short name (pipe-separated).
# All listed SLAs get the same excluded downtime when you pick that short name.
sla.AppOne: AppOne Services SLA | AppOne Services Overall SLA | AppOne Services Overall Quarterly
sla.AppTwo: AppTwo Services SLA | AppTwo Services Overall SLA | AppTwo Services Overall Quarterly

# Optional typing shortcuts (alias → short name from services list)
alias.app1: AppOne
alias.app2: AppTwo
